# ─────────────────────────────────────────────────────────────
# LOCAL DEV  — คัดลอกเป็น .env แล้วแก้ค่า
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://boat:boat@localhost:5432/boat?sslmode=disable
APP_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:4321

INTERNAL_API_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_SITE_URL=http://localhost:4321


# ─────────────────────────────────────────────────────────────
# RAILWAY — ตั้งใน Variables ของแต่ละ service (อย่า commit ค่าจริง)
# ─────────────────────────────────────────────────────────────
#
# service: api
#   DATABASE_URL   = ${{Postgres.DATABASE_URL}}       <- private network ไม่คิด egress
#   APP_ENV        = production
#   WEB_ORIGIN     = ${{web.RAILWAY_PUBLIC_DOMAIN}}   <- เติม https:// ข้างหน้าเอง
#   (PORT Railway ฉีดให้เอง ห้ามตั้งเอง)
#
# service: cron  (ใช้ Dockerfile เดียวกับ api)
#   DATABASE_URL   = ${{Postgres.DATABASE_URL}}
#
# service: web
#   INTERNAL_API_URL = http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080   <- SSR ใช้ตัวนี้ (ฟรี)
#   PUBLIC_API_URL   = https://${{api.RAILWAY_PUBLIC_DOMAIN}}        <- browser ใช้ตัวนี้
#   PUBLIC_SITE_URL  = https://${{web.RAILWAY_PUBLIC_DOMAIN}}
#
# ⚠ PUBLIC_* ถูก inline ตอน build ไม่ใช่ตอน run ถ้าแก้ค่าต้อง redeploy ใหม่


