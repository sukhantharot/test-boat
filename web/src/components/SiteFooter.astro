---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a class="brand" href="/">
        <span class="mark" aria-hidden="true">B</span>
        <span>Boat</span>
      </a>
      <p>
        มาร์เก็ตเพลสฟรีแลนซ์ไทย — ผู้จ้างติดต่อผู้ให้บริการได้โดยตรง
        ไม่ผ่านคนกลาง ไม่หักเปอร์เซ็นต์จากค่าจ้าง
      </p>
    </div>

    <nav aria-label="ผู้ให้บริการ">
      <h2>สำหรับฟรีแลนซ์</h2>
      <ul>
        <li><a href="/post/new">ลงประกาศฟรี</a></li>
        <li><a href="/#pricing">ค่าบริการ Pro</a></li>
        <li><a href="/login">เข้าสู่ระบบ</a></li>
      </ul>
    </nav>

    <nav aria-label="ผู้จ้างงาน">
      <h2>สำหรับผู้จ้าง</h2>
      <ul>
        <li><a href="/#feed">ค้นหาฟรีแลนซ์</a></li>
        <li><a href="/#how">วิธีใช้งาน</a></li>
      </ul>
    </nav>
  </div>

  <div class="container legal">
    <p>© {year} Boat</p>
    <ul>
      <li><a href="/terms">เงื่อนไขการใช้งาน</a></li>
      <li><a href="/privacy">นโยบายความเป็นส่วนตัว</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .inner {
    display: grid;
    gap: var(--sp-6);
    padding-block: var(--sp-7) var(--sp-6);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--sp-7);
    }
  }

  .about {
    max-width: 32rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
    color: var(--text);
    font-size: var(--step-0);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.5rem;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.8125rem;
    line-height: 1;
  }

  h2 {
    margin-bottom: var(--sp-3);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 700;
  }

  ul {
    display: grid;
    gap: var(--sp-2);
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--sp-4);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
  }

  .legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
  }
</style>
