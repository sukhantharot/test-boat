---
// แถบบนสุด — ติดหัวจอไว้เพราะปุ่ม "ลงประกาศฟรี" คือทางเข้าของฝั่งซัพพลาย
// ลิงก์ nav ใช้ path เต็ม (/#feed) ไม่ใช่ #feed เพื่อให้กดจากหน้าโพสก็เด้งกลับหน้าแรกถูก
import { getMe } from '../lib/session';

// getMe() ข้ามการยิง API ให้เองถ้าไม่มี cookie session อยู่
// ผู้เข้าชมส่วนใหญ่ (และ Googlebot) ไม่ได้ login เลยไม่มี request เสียเปล่า
const me = await getMe(Astro.request.headers.get('cookie'));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">B</span>
      <span class="name">Boat</span>
    </a>

    <nav class="nav" aria-label="เมนูหลัก">
      <a href="/#feed">หาฟรีแลนซ์</a>
      <a href="/#how">วิธีใช้งาน</a>
      <a href="/#pricing">ค่าบริการ</a>
    </nav>

    <div class="actions">
      {me ? (
        <>
          <span class="who" title={me.email}>
            {me.display_name}
            {me.is_pro && <span class="badge">Pro</span>}
          </span>
          {/* logout ต้องเป็น POST — ดูเหตุผลใน src/pages/logout.astro */}
          <form class="logout" method="post" action="/logout">
            <button type="submit">ออกจากระบบ</button>
          </form>
          <a class="btn btn-primary btn-sm" href="/post/new">ลงประกาศ</a>
        </>
      ) : (
        <>
          <a class="login" href="/login">เข้าสู่ระบบ</a>
          <a class="btn btn-primary btn-sm" href="/post/new">ลงประกาศฟรี</a>
        </>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    /* โปร่งแสง + blur ให้รู้ว่ามีเนื้อหาไหลอยู่ข้างใต้ แต่ยังอ่านตัวหนังสือออก
       บรรทัดแรกคือ fallback สำหรับเบราว์เซอร์ที่ไม่มี color-mix() — ห้ามให้พื้นหลุด
       เป็น transparent เพราะตัวหนังสือจะทับกับฟีดที่เลื่อนผ่าน */
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
  }

  /* เบราว์เซอร์ที่ไม่มี backdrop-filter ต้องได้พื้นทึบ ไม่ใช่ตัวหนังสือทับกัน */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--bg);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5625rem;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1;
  }

  .nav {
    display: none;
    gap: var(--sp-5);
    margin-inline-start: var(--sp-2);
  }

  .nav a {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-inline-start: auto;
  }

  .login {
    display: none;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .login:hover {
    color: var(--text);
  }

  /* ชื่อผู้ใช้ยาวได้ ต้องตัดด้วย ellipsis ไม่ให้ดันปุ่มลงประกาศตกจอบนมือถือ */
  .who {
    display: none;
    align-items: center;
    gap: var(--sp-2);
    max-width: 11rem;
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .logout {
    display: none;
  }

  /* ปุ่มใน form แต่ต้องดูเป็นลิงก์ให้เข้าชุดกับ nav ที่เหลือ */
  .logout button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .logout button:hover {
    color: var(--text);
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .nav,
    .login,
    .who,
    .logout {
      display: flex;
    }
  }
</style>
