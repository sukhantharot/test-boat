---
import Base from '../layouts/Base.astro';
import { apiGet, baht, type Post } from '../lib/api';

// SSR: เรียก Go API ผ่าน private network ตอน render
let posts: Post[] = [];
let apiDown = false;
try {
  const res = await apiGet<{ data: Post[] }>('/api/v1/posts');
  posts = res.data;
} catch {
  apiDown = true; // API ล่มไม่ควรทำให้หน้าเว็บ 500 ทั้งหน้า
}
---

<Base
  title="รวมฟรีแลนซ์รับงาน ทุกสาขา | ค้นหาผู้รับงานใกล้คุณ"
  description="รวมบริการจากฟรีแลนซ์ทั่วไทย กราฟิก เว็บ การตลาด ช่างซ่อม ติดต่อผู้ให้บริการได้โดยตรง ไม่ผ่านคนกลาง"
>
  <main>
    <header>
      <h1>หาฟรีแลนซ์รับงาน</h1>
      <p>เลือกผู้ให้บริการ แล้วติดต่อได้โดยตรง</p>
    </header>

    {apiDown && <p class="warn">ระบบขัดข้องชั่วคราว กรุณาลองใหม่อีกครั้ง</p>}

    <ul class="feed">
      {posts.map((p) => (
        <li class:list={['card', { pro: p.is_pro }]}>
          <a href={`/services/${p.slug}`}>
            <h2>{p.title}</h2>
            <p class="meta">
              {p.author}
              {p.is_pro && <span class="badge">ยืนยันแล้ว</span>}
              {p.province && <span> · {p.province}</span>}
            </p>
            <p class="price">{baht(p.price_from_satang)}</p>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && !apiDown && (
      <p class="empty">ยังไม่มีประกาศ — <a href="/post/new">เป็นคนแรกที่ลงประกาศ</a></p>
    )}
  </main>
</Base>

<style>
  :root { color-scheme: light dark; }
  main { max-width: 62rem; margin: 0 auto; padding: 2rem 1rem; font-family: system-ui, sans-serif; }
  h1 { font-size: 1.75rem; margin: 0 0 .25rem; }
  header p { color: #666; margin: 0 0 2rem; }
  .feed { list-style: none; padding: 0; display: grid; gap: 1rem;
          grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .card { border: 1px solid #e5e5e5; border-radius: .75rem; overflow: hidden; }
  .card.pro { border-color: #111; }
  .card a { display: block; padding: 1rem; color: inherit; text-decoration: none; }
  .card h2 { font-size: 1rem; margin: 0 0 .5rem; }
  .meta { font-size: .8125rem; color: #666; margin: 0 0 .5rem; }
  .badge { display: inline-block; margin-left: .375rem; padding: .0625rem .375rem;
           font-size: .6875rem; border-radius: 99px; background: #111; color: #fff; }
  .price { font-weight: 600; margin: 0; }
  .warn, .empty { padding: 1rem; background: #fff8e1; border-radius: .5rem; }
</style>
