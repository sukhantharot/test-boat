---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { apiGet, type Category, type Paged, type Post } from '../lib/api';

const PAGE_SIZE = 12;

// ── อ่านตัวกรองจาก query string ────────────────────────────────────────
// ทุกตัวกรองเป็น GET param ล้วนๆ ไม่มี JS: ใช้ได้แม้ JS พัง, กด back/forward ได้ถูก,
// ส่งลิงก์ผลการค้นหาให้คนอื่นได้ และ Googlebot ก็ไต่ได้เอง
const sp = Astro.url.searchParams;
const q = (sp.get('q') ?? '').trim().slice(0, 80);
const category = (sp.get('category') ?? '').trim().slice(0, 40);
const province = (sp.get('province') ?? '').trim().slice(0, 60);
const page = Math.max(1, Number.parseInt(sp.get('page') ?? '1', 10) || 1);
const filtered = Boolean(q || category || province);

// ── SSR: เรียก Go API ผ่าน private network ตอน render ──────────────────
// กรอง/แบ่งหน้าที่ SQL ไม่ใช่ที่ JS — pg_trgm กับ index ทำงานอยู่ฝั่ง Postgres แล้ว
// (ดู listPosts ใน api/internal/httpx/posts_handlers.go)
const query = new URLSearchParams({
  limit: String(PAGE_SIZE),
  offset: String((page - 1) * PAGE_SIZE),
});
if (q) query.set('q', q);
if (category) query.set('category', category);
if (province) query.set('province', province);

// allSettled ไม่ใช่ all: หมวดหมู่ล่มไม่ควรทำให้ฟีดหาย และฟีดล่มไม่ควรทำให้หน้าเว็บ 500
const [feed, cats] = await Promise.allSettled([
  apiGet<Paged<Post>>(`/api/v1/posts?${query}`),
  apiGet<{ data: Category[] }>('/api/v1/categories'),
]);

const apiDown = feed.status === 'rejected';
const posts = feed.status === 'fulfilled' ? feed.value.data : [];
const total = feed.status === 'fulfilled' ? (feed.value.meta?.total ?? posts.length) : 0;
const categories = cats.status === 'fulfilled' ? cats.value.data : [];

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const categoryName = categories.find((c) => c.slug === category)?.name ?? category;

// แยก "แนะนำ" (Pro) ออกหัวฟีดเฉพาะหน้าแรกที่ไม่ได้กรอง — นี่คือของที่ Pro จ่าย 300฿ ซื้อ
// หน้า 2 ขึ้นไปห้ามแยก เพราะ Pro อาจล้นมาจากหน้าก่อน หัวข้อ "แนะนำ" กลางฟีดจะงง
const grouped = !filtered && page === 1;
const proPosts = grouped ? posts.filter((p) => p.is_pro) : [];
const freePosts = grouped ? posts.filter((p) => !p.is_pro) : [];

/** ทำ URL ใหม่โดยคงตัวกรองอื่นไว้ — ค่า null = ถอดตัวกรองนั้นออก */
const hrefWith = (patch: Record<string, string | null>) => {
  const next = new URLSearchParams();
  if (q) next.set('q', q);
  if (category) next.set('category', category);
  if (province) next.set('province', province);
  for (const [key, value] of Object.entries(patch)) {
    if (value === null) next.delete(key);
    else next.set(key, value);
  }
  const qs = next.toString();
  // ต่อ #feed ท้ายเสมอ — กดชิปกรองแล้วต้องเด้งไปที่ผลลัพธ์ ไม่ใช่เด้งกลับขึ้น hero
  return qs ? `/?${qs}#feed` : '/#feed';
};

/** เปลี่ยนหน้าโดยคงตัวกรองเดิม (หน้า 1 ไม่ต้องมี ?page=1 ให้ URL สะอาด) */
const pageHref = (n: number) => hrefWith({ page: n <= 1 ? null : String(n) });

// ── SEO ─────────────────────────────────────────────────────────────────
const origin = new URL('/', Astro.site ?? Astro.url.origin).href;

// ⚠ ห้ามใส่ noindex ให้หน้าผลการค้นหา แม้มันจะเป็นเนื้อหาซ้ำก็ตาม
// Base.astro สร้าง canonical จาก pathname เพียวๆ -> /?q=xxx มี canonical = "/"
// ถ้าใส่ noindex ทับลงไปอีก Google อาจลากเอา noindex ไปใช้กับ canonical target
// ซึ่งก็คือ "หน้าแรก" — เท่ากับยิงตีนตัวเอง  canonical ตัวเดียวพอที่จะรวมสัญญาณแล้ว
const jsonLd = filtered
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Boat',
      url: origin,
      inLanguage: 'th-TH',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${origin}?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    };

const titleBits = [q && `“${q}”`, category && categoryName, province && province].filter(Boolean);
const title = titleBits.length
  ? `${titleBits.join(' · ')} | Boat รวมฟรีแลนซ์รับงานทั่วไทย`
  : 'รวมฟรีแลนซ์รับงาน ทุกสาขา | ค้นหาผู้รับงานใกล้คุณ';
---

<Base
  title={title}
  description="รวมบริการจากฟรีแลนซ์ทั่วไทย กราฟิก เว็บ การตลาด ช่างซ่อม ติดต่อผู้ให้บริการได้โดยตรง ไม่ผ่านคนกลาง"
  jsonLd={jsonLd}
>
  <main id="content">
    <!-- ═══════════════════════════════════════════════════ hero -->
    <section class="hero">
      <div class="container hero-inner">
        <h1>หาฟรีแลนซ์รับงาน<br /><em>ติดต่อตรง ไม่ผ่านคนกลาง</em></h1>
        <p class="lede">
          กราฟิก เว็บไซต์ การตลาด ตัดต่อวิดีโอ ช่างซ่อมในบ้าน
          เลือกผู้ให้บริการที่ถูกใจ แล้วคุยกับเจ้าตัวได้เลย ไม่มีค่าคอมมิชชั่น
        </p>

        <form class="search" method="get" action="/" role="search">
          <label class="sr-only" for="q">ค้นหาบริการ</label>
          <input
            id="q"
            type="search"
            name="q"
            value={q}
            placeholder="ค้นหาบริการ เช่น ออกแบบโลโก้, ทำเว็บ, ซ่อมแอร์"
            enterkeyhint="search"
            autocomplete="off"
          />
          {/* ค้นหาใหม่ต้องคงหมวด/จังหวัดที่เลือกไว้ แต่ต้องรีเซ็ตกลับหน้า 1
              (ไม่ใส่ page เป็น hidden) ไม่งั้นค้นคำใหม่แล้วไปโผล่หน้า 5 ที่ว่างเปล่า */}
          {category && <input type="hidden" name="category" value={category} />}
          {province && <input type="hidden" name="province" value={province} />}
          <button class="btn btn-primary" type="submit">ค้นหา</button>
        </form>

        <ul class="perks">
          <li>ลงประกาศฟรีตลอดชีพ</li>
          <li>ไม่หัก % จากค่าจ้าง</li>
          <li>ผู้ให้บริการทั่วประเทศ</li>
        </ul>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ feed -->
    <section class="feed-section container" id="feed">
      <div class="section-head">
        <div>
          <h2>{filtered ? 'ผลการค้นหา' : 'ฟรีแลนซ์ที่กำลังรับงาน'}</h2>
          <p class="sub">
            {apiDown
              ? 'ยังโหลดรายการไม่ได้'
              : filtered
                ? `พบ ${total.toLocaleString('th-TH')} ประกาศ`
                : 'ประกาศล่าสุดจากผู้ให้บริการ อัปเดตทุกวัน'}
            {!apiDown && posts.length > 0 && totalPages > 1 && ` · หน้า ${page} จาก ${totalPages}`}
          </p>
        </div>
        {filtered && <a class="chip" href="/#feed">ล้างทั้งหมด ✕</a>}
      </div>

      {/* ตัวกรองที่กำลังใช้ — แต่ละอันถอดออกเองได้ทีละตัว ไม่ใช่ล้างทั้งชุด
          จำเป็นเพราะ q/หมวด/จังหวัด ซ้อนกันได้ ถ้าถอดทีเดียวหมดจะต้องเริ่มใหม่ทุกครั้ง */}
      {filtered && (
        <ul class="active-filters">
          {q && (
            <li>
              <a class="chip" href={hrefWith({ q: null })}>คำค้น: {q} <span aria-hidden="true">✕</span></a>
            </li>
          )}
          {category && (
            <li>
              <a class="chip" href={hrefWith({ category: null })}>{categoryName} <span aria-hidden="true">✕</span></a>
            </li>
          )}
          {province && (
            <li>
              <a class="chip" href={hrefWith({ province: null })}>{province} <span aria-hidden="true">✕</span></a>
            </li>
          )}
        </ul>
      )}

      {categories.length > 0 && (
        <nav class="filters" aria-label="เลือกหมวดหมู่บริการ">
          <a class="chip" href={hrefWith({ category: null })} aria-current={category ? 'false' : 'true'}>
            ทุกหมวด
          </a>
          {categories.map((c) => (
            <a
              class="chip"
              href={hrefWith({ category: c.slug })}
              aria-current={category === c.slug ? 'true' : 'false'}
            >
              {c.name}
            </a>
          ))}
        </nav>
      )}

      {apiDown && (
        <p class="notice">
          ระบบขัดข้องชั่วคราว ยังโหลดรายการประกาศไม่ได้ — กรุณาลองใหม่อีกครั้งในอีกสักครู่
        </p>
      )}

      {/* ⚠ เคสนี้ต้องมาก่อน 2 เคสข้างล่าง: ขอหน้าที่เลยของจริงไปแล้ว (bookmark เก่า,
          ลิงก์ค้างใน Google, หรือคนแก้ URL เอง)  ห้ามบอกว่า "ยังไม่มีประกาศในระบบ"
          เพราะมีเป็นพันรายการ แค่หน้านี้ไม่มี — และต้องมีทางกลับ ไม่งั้นตีบตัน
          (API คืน meta.total = 0 เมื่อ offset เลยข้อมูล เพราะ count(*) OVER () ไม่มีแถวให้นับ
           ทำให้ totalPages ยุบเหลือ 1 แล้ว pager หายไปด้วย) */}
      {!apiDown && posts.length === 0 && page > 1 && (
        <div class="blank">
          <h3>หน้านี้ไม่มีประกาศแล้ว</h3>
          <p>ประกาศอาจถูกปิดหรือถูกย้ายไปแล้วตั้งแต่คุณเปิดลิงก์นี้</p>
          <a class="btn btn-primary" href={pageHref(1)}>กลับไปหน้าแรกของรายการ</a>
        </div>
      )}

      {!apiDown && !filtered && posts.length === 0 && page === 1 && (
        <div class="blank">
          <h3>ยังไม่มีประกาศในระบบ</h3>
          <p>เว็บเพิ่งเปิด — ลงประกาศตอนนี้แล้วคุณจะเป็นคนแรกที่ผู้จ้างเห็น</p>
          <a class="btn btn-primary" href="/post/new">เป็นคนแรกที่ลงประกาศ</a>
        </div>
      )}

      {!apiDown && filtered && posts.length === 0 && page === 1 && (
        <div class="blank">
          <h3>ไม่พบประกาศที่ตรงกับที่ค้นหา</h3>
          <p>ลองใช้คำที่สั้นลง เอาตัวกรองบางตัวออก หรือดูประกาศทั้งหมดที่มีอยู่</p>
          <a class="btn btn-outline" href="/#feed">ดูประกาศทั้งหมด</a>
        </div>
      )}

      {/* แยก "แนะนำ" ออกหัวฟีด — นี่คือของที่ Pro จ่าย 300฿ ซื้อ: พื้นที่บนสุด
          ที่มีหัวข้อของตัวเอง  ตอนกรอง/หน้า 2+ เอามารวมกันจะอ่านผลลัพธ์ง่ายกว่า
          (ลำดับ pro-มาก่อน มาจาก ORDER BY ของ API อยู่แล้ว) */}
      {grouped && proPosts.length > 0 ? (
        <>
          <h3 class="group">
            แนะนำ
            <span>ผู้ให้บริการที่ยืนยันตัวตนแล้ว</span>
          </h3>
          <ul class="grid">
            {proPosts.map((post) => <PostCard post={post} />)}
          </ul>

          {freePosts.length > 0 && (
            <>
              <h3 class="group">
                ประกาศล่าสุด
                <span>เรียงตามเวลาที่อัปเดต</span>
              </h3>
              <ul class="grid">
                {freePosts.map((post) => <PostCard post={post} />)}
              </ul>
            </>
          )}
        </>
      ) : (
        posts.length > 0 && (
          <>
            {/* การ์ดใช้ h4 ตัวหัวข้อกลุ่มใช้ h3 — เคสนี้ไม่มีหัวข้อกลุ่ม ต้องใส่ h3
                ที่มองไม่เห็นกันลำดับ heading ข้ามขั้น (h2 -> h4) ตอนอ่านด้วย screen reader */}
            <h3 class="sr-only">รายการประกาศ</h3>
            <ul class="grid">
              {posts.map((post) => <PostCard post={post} />)}
            </ul>
          </>
        )
      )}

      {/* แบ่งหน้าด้วยลิงก์จริง ไม่ใช่ infinite scroll — Googlebot ไต่ได้ และคนกด
          back จากหน้าโพสแล้วยังอยู่หน้าเดิม  rel prev/next บอกความสัมพันธ์ให้ครอว์เลอร์ */}
      {/* ต้องมี posts.length > 0: ขอหน้าที่เลยของจริง (page=999 จาก 84 หน้า) จะได้
          ไม่ขึ้น pager ว่า "หน้า 999 / 84" ซึ่งอ่านแล้วสับสน — เคสนั้นใช้ปุ่ม
          "กลับไปหน้าแรกของรายการ" ในกล่องว่างข้างบนพากลับแทน */}
      {!apiDown && posts.length > 0 && totalPages > 1 && (
        <nav class="pager" aria-label="หน้าของผลการค้นหา">
          {page > 1 ? (
            <a class="btn btn-outline btn-sm" rel="prev" href={pageHref(page - 1)}>← ก่อนหน้า</a>
          ) : (
            <span class="btn btn-outline btn-sm" aria-disabled="true">← ก่อนหน้า</span>
          )}

          <p class="pager-at">หน้า {page} / {totalPages}</p>

          {page < totalPages ? (
            <a class="btn btn-outline btn-sm" rel="next" href={pageHref(page + 1)}>ถัดไป →</a>
          ) : (
            <span class="btn btn-outline btn-sm" aria-disabled="true">ถัดไป →</span>
          )}
        </nav>
      )}
    </section>

    <!-- ═══════════════════════════════════════════════════ วิธีใช้งาน -->
    <section class="how container" id="how">
      <p class="eyebrow">สำหรับผู้จ้างงาน</p>
      <h2>จ้างงานได้ใน 3 ขั้น</h2>
      <ol class="steps">
        <li>
          <span class="num">1</span>
          <h3>ค้นหาบริการที่ต้องการ</h3>
          <p>พิมพ์งานที่อยากจ้างในช่องค้นหา หรือเลือกจากหมวดหมู่บริการ</p>
        </li>
        <li>
          <span class="num">2</span>
          <h3>เทียบราคาและผลงาน</h3>
          <p>ดูขอบเขตงานกับราคาเริ่มต้นของแต่ละคน ก่อนตัดสินใจติดต่อ</p>
        </li>
        <li>
          <span class="num">3</span>
          <h3>คุยกับเจ้าตัวโดยตรง</h3>
          <p>ติดต่อทางเบอร์หรือ LINE ตกลงราคาและงานกันเอง เราไม่หักค่าคอม</p>
        </li>
      </ol>
    </section>

    <!-- ═══════════════════════════════════════════════════ ค่าบริการ -->
    <section class="pricing" id="pricing">
      <div class="container">
        <div class="pricing-head">
          <p class="eyebrow">สำหรับฟรีแลนซ์</p>
          <h2>ลงประกาศฟรี จ่ายเมื่ออยากให้คนเห็นมากขึ้น</h2>
          <p class="lede">
            บัญชีฟรีใช้ได้ตลอดไป ไม่มีวันหมดอายุ
            อัปเกรดเป็น Pro เมื่อต้องการอยู่บนสุดของฟีดและเปิดเบอร์ให้ผู้จ้างโทรตรง
          </p>
        </div>

        <div class="plans">
          <article class="plan">
            <h3>ฟรี</h3>
            <p class="amount">0฿<span>ตลอดชีพ</span></p>
            <ul>
              <li>ลงประกาศได้ 1 ชิ้น</li>
              <li>รูปภาพ 1 รูป</li>
              <li>แสดงในฟีดปกติ</li>
              <li class="off">ผู้จ้างติดต่อผ่านฟอร์ม (ซ่อนเบอร์)</li>
              <li class="off">ไม่มีสถิติผู้เข้าชม</li>
            </ul>
            <a class="btn btn-outline" href="/post/new">เริ่มลงประกาศ</a>
          </article>

          <article class="plan featured">
            <p class="ribbon">คุ้มที่สุด</p>
            <h3>Pro</h3>
            <p class="amount">300฿<span>/ 30 วัน</span></p>
            <ul>
              <li><strong>อยู่บนสุดของฟีดเสมอ</strong></li>
              <li>ลงประกาศได้ 10 ชิ้น · รูป 10 รูป</li>
              <li>แสดงเบอร์และ LINE ให้โทรตรง</li>
              <li>กด Bump ดันประกาศขึ้นบนได้</li>
              <li>ดูสถิติผู้เข้าชมและจำนวนคนติดต่อ</li>
            </ul>
            <a class="btn btn-primary" href="/post/new">อัปเกรดเป็น Pro</a>
            <p class="fine">จ่ายครั้งเดียวต่อรอบ ไม่ต้องผูกบัตร ไม่ตัดเงินอัตโนมัติ</p>
          </article>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ── hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  /* แสงนวลๆ หลังหัวข้อ ให้หน้าไม่แบน แต่ไม่แย่งความสนใจจากช่องค้นหา */
  .hero::before {
    content: '';
    position: absolute;
    inset: -40% 0 auto;
    height: 42rem;
    background: radial-gradient(
      55% 50% at 50% 50%,
      color-mix(in srgb, var(--brand) 14%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding-block: var(--sp-8) var(--sp-7);
    text-align: center;
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  h1 em {
    color: var(--brand-text);
    font-style: normal;
  }

  .lede {
    max-width: 40rem;
    margin: var(--sp-4) auto 0;
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  /* ── ช่องค้นหา ─────────────────────────────────────────────────────── */
  .search {
