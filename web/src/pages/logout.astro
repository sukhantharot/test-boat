---
import { apiRequest, redirectWithCookies } from '../lib/session';

export const prerender = false;

// รับแค่ POST โดยตั้งใจ — ถ้าทำเป็นลิงก์ GET ใครก็ฝัง <img src="/logout"> ในหน้าอื่น
// แล้วเตะผู้ใช้ออกจากระบบได้ (CSRF แบบไม่ร้ายแรงแต่กวนมาก)
// ปุ่ม logout ใน SiteHeader จึงเป็น <form method="post">
if (Astro.request.method !== 'POST') {
  return Astro.redirect('/', 303);
}

const res = await apiRequest('/api/v1/auth/logout', {
  method: 'POST',
  cookie: Astro.request.headers.get('cookie'),
});

// API ตอบด้วย Set-Cookie ที่ MaxAge=-1 (auth.ClearCookie) ต้อง relay ต่อ
// ไม่งั้น cookie ยังอยู่บนโดเมนเว็บแล้วกด logout ไม่ออก
return redirectWithCookies('/', res, 303);
---
