---
import Base from '../../layouts/Base.astro';
import { apiGet, baht } from '../../lib/api';

type Detail = {
  id: number;
  slug: string;
  title: string;
  description: string;
  province: string | null;
  price_from_satang: number | null;
  price_unit: string | null;
  author: string;
  is_pro: boolean;
  visible: boolean;                 // false = หมดอายุ/ถูกซ่อน
  contact_phone: string | null;     // null เมื่อเจ้าของเป็น free tier
  contact_line: string | null;
};

const { slug } = Astro.params;

let post: Detail;
try {
  const res = await apiGet<{ data: Detail }>(`/api/v1/posts/${slug}`);
  post = res.data;
} catch {
  // ไม่มีโพสนี้จริงๆ ค่อย 404 (ต่างจากกรณี "หมดอายุ" ข้างล่าง)
  return new Response(null, { status: 404 });
}

// ═══ กติกา SEO ข้อสำคัญที่สุดของเว็บนี้ ═══
// โพสหมดอายุ "ห้าม 404" เด็ดขาด — ถ้า 404 อันดับที่สะสมมาหายถาวร
// ให้คงหน้าไว้ + noindex + ถอดออกจาก sitemap พอเจ้าของจ่ายต่อ อันดับกลับมาเอง
const noindex = !post.visible;

const jsonLd = post.visible
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: post.title,
      description: post.description.slice(0, 300),
      provider: { '@type': 'Person', name: post.author },
      ...(post.province && { areaServed: { '@type': 'Place', name: post.province } }),
      ...(post.price_from_satang != null && {
        offers: {
          '@type': 'Offer',
          price: (post.price_from_satang / 100).toFixed(2),
          priceCurrency: 'THB',
          availability: 'https://schema.org/InStock',
        },
      }),
    }
  : undefined;

const hasContact = Boolean(post.contact_phone || post.contact_line);
---

<Base
  title={`${post.title} | ${post.author}`}
  description={post.description.slice(0, 155)}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <main>
    {!post.visible && (
      <p class="expired">
        ประกาศนี้ปิดรับงานชั่วคราว — <a href="/">ดูฟรีแลนซ์คนอื่นที่ยังรับงานอยู่</a>
      </p>
    )}

    <h1>{post.title}</h1>
    <p class="meta">
      โดย {post.author}
      {post.is_pro && <span class="badge">ยืนยันแล้ว</span>}
      {post.province && <span> · {post.province}</span>}
    </p>
    <p class="price">{baht(post.price_from_satang)}</p>

    <article>{post.description}</article>

    {post.visible && (
      hasContact ? (
        /* เจ้าของเป็น Pro -> โชว์ช่องทางติดต่อตรง (ต้องยิงนับ lead ก่อนเปิดเผย) */
        <section class="contact">
          <h2>ติดต่อผู้ให้บริการ</h2>
          {post.contact_phone && <a href={`tel:${post.contact_phone}`}>{post.contact_phone}</a>}
          {post.contact_line && <span>LINE: {post.contact_line}</span>}
        </section>
      ) : (
        /* Free tier -> ซ่อนเบอร์ ให้ส่งฟอร์มแทน (ยังนับเป็น lead เหมือนกัน) */
        <section class="contact">
          <h2>สนใจงานนี้?</h2>
          <p>ส่งข้อความถึงผู้ให้บริการ แล้วรอการติดต่อกลับ</p>
          <a class="btn" href={`/contact/${post.slug}`}>ส่งข้อความ</a>
        </section>
      )
    )}
  </main>
</Base>

<style>
  main { max-width: 44rem; margin: 0 auto; padding: 2rem 1rem; font-family: system-ui, sans-serif; }
  h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
  .meta { color: #666; font-size: .875rem; margin: 0 0 .5rem; }
  .badge { margin-left: .375rem; padding: .0625rem .375rem; font-size: .6875rem;
           border-radius: 99px; background: #111; color: #fff; }
  .price { font-size: 1.25rem; font-weight: 600; margin: 0 0 1.5rem; }
  article { white-space: pre-wrap; line-height: 1.7; }
  .expired { padding: .75rem 1rem; background: #fff3cd; border-radius: .5rem; margin-bottom: 1.5rem; }
  .contact { margin-top: 2rem; padding: 1.25rem; border: 1px solid #e5e5e5; border-radius: .75rem;
             display: grid; gap: .5rem; }
  .contact h2 { font-size: 1rem; margin: 0; }
  .btn { justify-self: start; padding: .625rem 1.25rem; background: #111; color: #fff;
         border-radius: .5rem; text-decoration: none; }
</style>
