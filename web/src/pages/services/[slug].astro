---
import Base from '../../layouts/Base.astro';
import { apiGet, baht } from '../../lib/api';

type Detail = {
  id: number;
  slug: string;
  title: string;
  description: string;
  province: string | null;
  price_from_satang: number | null;
  price_unit: string | null;
  author: string;
  is_pro: boolean;
  visible: boolean;                 // false = หมดอายุ/ถูกซ่อน
  contact_phone: string | null;     // null เมื่อเจ้าของเป็น free tier
  contact_line: string | null;
};

const { slug } = Astro.params;

let post: Detail;
try {
  const res = await apiGet<{ data: Detail }>(`/api/v1/posts/${slug}`);
  post = res.data;
} catch {
  // ไม่มีโพสนี้จริงๆ ค่อย 404 (ต่างจากกรณี "หมดอายุ" ข้างล่าง)
  return new Response(null, { status: 404 });
}

// ═══ กติกา SEO ข้อสำคัญที่สุดของเว็บนี้ ═══
// โพสหมดอายุ "ห้าม 404" เด็ดขาด — ถ้า 404 อันดับที่สะสมมาหายถาวร
// ให้คงหน้าไว้ + noindex + ถอดออกจาก sitemap พอเจ้าของจ่ายต่อ อันดับกลับมาเอง
const noindex = !post.visible;

const jsonLd = post.visible
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: post.title,
      description: post.description.slice(0, 300),
      provider: { '@type': 'Person', name: post.author },
      ...(post.province && { areaServed: { '@type': 'Place', name: post.province } }),
      ...(post.price_from_satang != null && {
        offers: {
          '@type': 'Offer',
          price: (post.price_from_satang / 100).toFixed(2),
          priceCurrency: 'THB',
          availability: 'https://schema.org/InStock',
        },
      }),
    }
  : undefined;

const hasContact = Boolean(post.contact_phone || post.contact_line);
---

<Base
  title={`${post.title} | ${post.author}`}
  description={post.description.slice(0, 155)}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <main id="content">
    {!post.visible && (
      <p class="expired">
        ประกาศนี้ปิดรับงานชั่วคราว — <a href="/">ดูฟรีแลนซ์คนอื่นที่ยังรับงานอยู่</a>
      </p>
    )}

    <h1>{post.title}</h1>
    <p class="meta">
      โดย {post.author}
      {post.is_pro && <span class="badge">ยืนยันแล้ว</span>}
      {post.province && <span> · {post.province}</span>}
    </p>
    <p class="price">{baht(post.price_from_satang)}</p>

    <article>{post.description}</article>

    {post.visible && (
      hasContact ? (
        /* เจ้าของเป็น Pro -> โชว์ช่องทางติดต่อตรง (ต้องยิงนับ lead ก่อนเปิดเผย) */
        <section class="contact">
          <h2>ติดต่อผู้ให้บริการ</h2>
          {post.contact_phone && <a href={`tel:${post.contact_phone}`}>{post.contact_phone}</a>}
          {post.contact_line && <span>LINE: {post.contact_line}</span>}
        </section>
      ) : (
        /* Free tier -> ซ่อนเบอร์ ให้ส่งฟอร์มแทน (ยังนับเป็น lead เหมือนกัน) */
        <section class="contact">
          <h2>สนใจงานนี้?</h2>
          <p>ส่งข้อความถึงผู้ให้บริการ แล้วรอการติดต่อกลับ</p>
          <a class="btn btn-primary" href={`/contact/${post.slug}`}>ส่งข้อความ</a>
        </section>
      )
    )}
  </main>
</Base>

<style>
  /* สีและระยะทั้งหมดมาจาก token ใน src/styles/global.css — ห้าม hardcode ที่นี่
     ไม่งั้นหน้านี้จะเป็นหน้าเดียวที่พังตอนโหมดมืด */
  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-4) var(--sp-7);
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: var(--sp-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) 0;
    align-items: center;
    color: var(--text-muted);
    font-size: var(--step--1);
    margin-bottom: var(--sp-3);
  }

  .badge {
    margin-left: var(--sp-2);
  }

  .price {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-5);
  }

  /* description เป็น plain text จากผู้ใช้ ต้องคง newline ที่เขาเคาะไว้ */
  article {
    white-space: pre-wrap;
    line-height: var(--lh-body);
  }

  .expired {
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-5);
    border: 1px solid var(--warn-border);
    border-radius: var(--r-md);
    background: var(--warn-bg);
    color: var(--warn-text);
    font-size: var(--step--1);
  }

  .contact {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-subtle);
  }

  .contact h2 {
    font-size: var(--step-1);
  }

  .contact > a[href^='tel:'] {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .contact p {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .btn {
    justify-self: start;
    margin-top: var(--sp-2);
  }
</style>
